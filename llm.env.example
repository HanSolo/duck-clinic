# Language model of the referral agent. Copy to llm.env and run: docker compose up -d   (no rebuild needed).
# Use the same values as in DuckInsurance and the therapy clinic, so that all three agents talk to the same model.
# Do not commit a real API key (llm.env is in .gitignore).

# ---- Option A: local Ollama on the host (default).
# On Linux start Ollama with OLLAMA_HOST=0.0.0.0 ollama serve, so that the container can reach it.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3.8:27b
LLM_API_KEY=ollama

# ---- Option B: Claude through the Anthropic API. Comment out option A and fill in:
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=<a Claude model name your API account can use>
# LLM_API_KEY=sk-ant-...

# ---- Option C: any service with the OpenAI Chat Completions format. Comment out option A and fill in.
# LLM_BASE_URL includes the version path, for example:
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Mistral     https://api.mistral.ai/v1
#   Ollama      http://host.docker.internal:11434/v1
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<a model name of that service>
# LLM_API_KEY=<key of that service>

# Optional: answer length. anthropic: default 1024. openai: no limit is sent unless you set it
# (newer OpenAI models reject this field; Groq, OpenRouter and Mistral accept it).
# LLM_MAX_TOKENS=1024
