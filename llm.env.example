# Language model of the agent: a local Ollama on the host. Copy to llm.env and run: docker compose up -d   (no rebuild needed).
# Use the same values as in DuckInsurance and the therapy clinic, so that all three agents talk to the same model.
# On Linux start Ollama with OLLAMA_HOST=0.0.0.0 ollama serve, so that the container can reach it.
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3.8:27b
LLM_PROVIDER=ollama
